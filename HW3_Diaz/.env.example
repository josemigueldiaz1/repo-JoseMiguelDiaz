# =============================================================================
#  HW3_Diaz - Plantilla de credenciales
#
#  Copia este archivo como `.env` (sin el sufijo .example) y rellena los
#  valores. `.env` esta en .gitignore y NUNCA debe subirse al repositorio.
#
#      copy .env.example .env
#
#  Este archivo declara solo los NOMBRES de las variables, nunca sus valores.
# =============================================================================

# -----------------------------------------------------------------------------
#  Modelo generativo (OBLIGATORIO)
# -----------------------------------------------------------------------------
# DeepSeek no tiene SDK propio: se usa el cliente de OpenAI apuntando su base_url.
# La clave se obtiene en https://platform.deepseek.com
DEEPSEEK_API_KEY=

# -----------------------------------------------------------------------------
#  Embeddings por API (OPCIONAL)
# -----------------------------------------------------------------------------
# Solo se necesita para la comparacion de embeddings de la Tarea 1, Fase 4
# (text-embedding-3-small). Si se deja vacio, el pipeline hace la comparacion
# igualmente pero marca la fila del modelo API como "no ejecutada" en vez de
# fallar: el resto del proyecto no depende de esta clave.
OPENAI_API_KEY=

# -----------------------------------------------------------------------------
#  Innovacion: bot de Telegram (OPCIONAL)
# -----------------------------------------------------------------------------
# Token que entrega @BotFather. Sin el, el bot simplemente no se lanza.
TELEGRAM_BOT_TOKEN=
# IDs numericos de usuario separados por coma; lista blanca de quien puede usarlo.
TELEGRAM_ALLOWLIST=
